# ===== Application =====
APP_NAME="AI Voice Studio"
APP_ENV=local
DEBUG=false
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://voiceuser:voicepass@localhost:5432/voice_studio
# Set to false only if you intentionally want SQLAlchemy sync mode.
DB_ECHO=false

# ===== Security =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-64-byte-random-string
SESSION_COOKIE_NAME=voice_studio_session
SESSION_MAX_AGE_SECONDS=86400
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# ===== Storage (absolute or relative to repo root) =====
STORAGE_ROOT=./storage
MODEL_CACHE_DIR=./storage/models
GENERATED_AUDIO_DIR=./storage/generated
REFERENCE_AUDIO_DIR=./storage/reference_audio
TEMP_DIR=./storage/temporary
EXPORT_DIR=./storage/exports
MAX_UPLOAD_MB=50

# ===== Inference / CPU =====
INFERENCE_WORKER_POLL_SECONDS=1.0
INFERENCE_LOAD_TIMEOUT_SECONDS=180
INFERENCE_GENERATION_TIMEOUT_SECONDS=600
CPU_THREADS=6
INTEROP_THREADS=2
OMP_NUM_THREADS=6
MKL_NUM_THREADS=6
MAX_RAM_MB_FOR_INFERENCE=9000
MIN_FREE_DISK_MB=2048

# ===== Long-form =====
LONGFORM_MAX_CHARS=50000
LONGFORM_CHUNK_TARGET_CHARS=350
LONGFORM_CHUNK_MAX_CHARS=600
LONGFORM_PAUSE_MS=350

# ===== FFmpeg =====
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# ===== Frontend =====
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000